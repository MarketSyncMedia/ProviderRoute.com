{
  "name": "providerroute",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts",
    "test:tenant": "vitest run tests/tenant-isolation",
    "test:tenant:watch": "vitest tests/tenant-isolation",
    "test:tenant:lint": "eslint tests/tenant-isolation vitest.config.ts",
    "test:tenant:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check:edge-safety": "node scripts/check-public-edge-safety.mjs",
    "check:edge-types": "npx --yes deno@2.9.5 check supabase/functions/widget-data/index.ts supabase/functions/track-session/index.ts supabase/functions/invite-member/index.ts",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:db-types": "node scripts/check-db-types.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:artifacts": "node scripts/check-build-artifacts.mjs",
    "verify": "node scripts/verify-release.mjs",
    "verify:db": "node scripts/verify-database.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "papaparse": "^5.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "@hookform/resolvers": {
      "ajv": "^6.12.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.1"
  }
}
